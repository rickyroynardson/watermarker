{
  "uid": "watermarker-metrics",
  "title": "Watermarker metrics",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(watermarker_http_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le, route) (rate(watermarker_http_request_duration_seconds_bucket[$__rate_interval])))) >= 0",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No recent observations"
        },
        "overrides": []
      },
      "description": "Estimated percentile from histogram buckets. No observations in the recent rate window means no latency value; it does not mean zero seconds. Rates need at least two exports (60 seconds apart by default)."
    },
    {
      "id": 3,
      "title": "Consumer messages / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (rate(watermarker_message_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Consumer p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le, operation) (rate(watermarker_message_duration_seconds_bucket[$__rate_interval])))) >= 0",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No recent observations"
        },
        "overrides": []
      },
      "description": "Estimated percentile from histogram buckets. No observations in the recent rate window means no latency value; it does not mean zero seconds. Rates need at least two exports (60 seconds apart by default)."
    },
    {
      "id": 5,
      "title": "Worker attempts / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(watermarker_job_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Worker p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(watermarker_job_duration_seconds_bucket[$__rate_interval])))) >= 0",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No recent observations"
        },
        "overrides": []
      },
      "description": "Estimated percentile from histogram buckets. No observations in the recent rate window means no latency value; it does not mean zero seconds. Rates need at least two exports (60 seconds apart by default)."
    },
    {
      "id": 7,
      "title": "Batch completion p50",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.5, sum by (le, outcome) (rate(watermarker_batch_duration_seconds_bucket[$__rate_interval])))) >= 0",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No recent observations"
        },
        "overrides": []
      },
      "description": "Estimated percentile from histogram buckets. No observations in the recent rate window means no latency value; it does not mean zero seconds. Rates need at least two exports (60 seconds apart by default)."
    },
    {
      "id": 8,
      "title": "Batch completion p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le, outcome) (rate(watermarker_batch_duration_seconds_bucket[$__rate_interval])))) >= 0",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No recent observations"
        },
        "overrides": []
      },
      "description": "Estimated percentile from histogram buckets. No observations in the recent rate window means no latency value; it does not mean zero seconds. Rates need at least two exports (60 seconds apart by default)."
    },
    {
      "id": 9,
      "title": "Observed batch completions since process start",
      "description": "Cumulative observations from currently exporting process instances, grouped by outcome. Resets on process restart; not a durable database total.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (watermarker_batch_duration_seconds_count)",
          "legendFormat": "{{outcome}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "Observed worker attempts since process start",
      "description": "Cumulative observations from currently exporting process instances, grouped by outcome. Resets on process restart; not a durable database total.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (watermarker_job_duration_seconds_count)",
          "legendFormat": "{{outcome}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "title": "Database pool utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (service_name, instance) (watermarker_db_pool_connections{state=\"acquired\"}) / max by (service_name, instance) (watermarker_db_pool_limit)",
          "legendFormat": "{{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "description": "Acquired connections / configured limit per process. A checked-out connection can be executing SQL, waiting on a lock, or held idle. Sampled at export time; brief spikes may be missed."
    },
    {
      "id": 12,
      "title": "Database pool connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, instance, state) (watermarker_db_pool_connections)",
          "legendFormat": "{{service_name}} {{instance}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "description": "Acquired, idle and constructing connections per process. Each API, consumer and monitor instance owns its own pool; the monitor cannot inspect the API pool."
    },
    {
      "id": 13,
      "title": "Database pool waits and cancellations / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, instance) (rate(watermarker_db_pool_waits_total[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{instance}} waited, then acquired"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name, instance) (rate(watermarker_db_pool_canceled_total[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{instance}} canceled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "description": "Wait counter includes only successful acquisitions that waited for a released or newly constructed connection. Canceled acquisition attempts are counted separately. Not the number currently waiting. Rates need two exports."
    },
    {
      "id": 14,
      "title": "Database pool mean wait for successful waiting acquires",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, instance) (rate(watermarker_db_pool_wait_duration_seconds_total[$__rate_interval])) / (sum by (service_name, instance) (rate(watermarker_db_pool_waits_total[$__rate_interval])) > 0)",
          "legendFormat": "{{service_name}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "description": "Mean accumulated wait time / successful waiting acquisitions. Includes connection construction waits. Canceled waits are excluded; not SQL latency or a percentile. No successful waiting acquisitions means no value."
    }
  ]
}
