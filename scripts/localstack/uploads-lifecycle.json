{
  "Rules": [
    {
      "ID": "expire-staging-uploads",
      "Status": "Enabled",
      "Filter": { "Prefix": "uploads/" },
      "Expiration": { "Days": 7 },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 7 }
    },
    {
      "ID": "remove-staging-delete-markers",
      "Status": "Enabled",
      "Filter": { "Prefix": "uploads/" },
      "Expiration": { "ExpiredObjectDeleteMarker": true }
    }
  ]
}
