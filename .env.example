APP_ENV=
DATABASE_URL=
LOCALSTACK_AUTH_TOKEN=

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET=
SQS_JOBS_QUEUE_URL=
SQS_RESULTS_QUEUE_URL=
# Separate backlog monitor also needs the two DLQ URLs.
SQS_JOBS_DLQ_QUEUE_URL=
SQS_RESULTS_DLQ_QUEUE_URL=

# Logs: start with make observability-up, then uncomment to enable OTLP/HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# Leave OTEL_SERVICE_NAME unset to retain distinct API/consumer/worker names.
# Worker cancellation checks: use the same random token in API and worker.
WORKER_API_URL=http://localhost:8080
WORKER_API_TOKEN=

# Browser sign-in (optional; configure all three to enable OIDC).
# Register this callback with the provider: http://localhost:5173/api/auth/callback
APP_ORIGIN=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Required for confidential clients; leave empty only for a provider's public PKCE client.
OIDC_CLIENT_SECRET=
